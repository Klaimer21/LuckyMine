class_name Skills
extends RefCounted
## Дерево навыков: три ветки по четыре навыка, покупаются по порядку. Очки даёт «Новая шахта» (и два очка на старте).
## Числа эффектов лежат в ClickerState (DRILL_BONUS, DYNAMITE_*, ...); здесь только названия, подписи и цены.

const COSTS := [1, 2, 4, 6]                # цены навыков по умолчанию (очки)
const MAX_LEVEL := 4

## id ветки, название, значок, навыки [название, описание].
const BRANCHES := [
	{"id": "drill", "name": "Бур", "icon": "tap", "nodes": [
		["Ручной бур", "+10% глыб в секунду"],
		["Пневмобур", "+20% глыб в секунду"],
		["Алмазное сверло", "+35% глыб в секунду"],
		["Проходческий щит", "+60% глыб в секунду"]]},
	{"id": "dynamite", "name": "Динамит", "icon": "dynamite", "nodes": [
		["Склад взрывчатки", "вместимость склада 20 вместо 10"],
		["Тяжёлый заряд", "награда динамита: 38 с дохода вместо 30"],
		["Цепной взрыв", "через секунду второй взрыв на 30% награды"],
		["Большой взрыв", "вместимость склада 30; динамит запускает «Золотой запал»"]]},
	{"id": "yield", "name": "Добыча", "icon": "cross", "costs": [1500, 3000, 6000, 12000], "nodes": [
		["Опытный бригадир", "+15% дохода"],
		["Крупная выработка", "+35% дохода"],
		["Отлаженная смена", "+60% дохода"],
		["Золотой стандарт", "доход ×2"]]},
	{"id": "luck", "name": "Удача", "icon": "gem", "nodes": [
		["Счастливая кирка", "+30% к шансу алмазной жилы"],
		["Золотая жила", "«Золотой запал» от золота на 2 с дольше"],
		["Нюх на золото", "золотая глыба появляется на 30% чаще"],
		["Фарт шахтёра", "3% глыб «счастливые»: награда ×5 и всегда с золотом"]]},
]


## Цены ветки по уровням: свои, если заданы (ветка «Добыча» дорогая, рассчитана на игру после ядра), иначе общие.
static func costs_of(branch_id: String) -> Array:
	for branch in BRANCHES:
		if str(branch["id"]) == branch_id:
			return branch.get("costs", COSTS)
	return COSTS

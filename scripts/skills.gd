## Цены ветки по уровням: свои, если заданы (ветка «Добыча» дорогая, рассчитана на игру после ядра), иначе общие.
static func costs_of(branch_id: String) -> Array:
	for branch in BRANCHES:
		if str(branch["id"]) == branch_id:
			return branch.get("costs", COSTS)
	return COSTS

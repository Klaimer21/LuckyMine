static func text(id: String) -> String:
	return str(TEXTS.get(id, ""))


## Сколько секунд показывать подсказку: чем длиннее текст, тем дольше (около 17 знаков в секунду плюс запас).
static func seconds_for(text: String) -> float:
	return clampf(3.0 + 0.06 * float(text.length()), 5.0, 14.0)
